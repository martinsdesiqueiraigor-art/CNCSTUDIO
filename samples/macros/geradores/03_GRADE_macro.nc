%
O9012 (MACRO B - FURACAO EM GRADE - RASCUNHO)
(ENTRADAS G65: X=#24 Y=#25 I=#4 J=#5 U=#21 V=#22 A=#1 Z=#26 R=#18 Q=#17 F=#9)
(#4 COLUNAS EM X; #5 LINHAS EM Y; #21 ESPACAMENTO X; #22 ESPACAMENTO Y)
(#1 ANGULO DA GRADE; #24 #25 PRIMEIRO FURO; #26 FUNDO; #18 PLANO R; #17 PICADA)
(#6 LINHA; #10 COLUNA; #12 LINHA PAR OU IMPAR; #14 COLUNA NA ORDEM)
(#15 #16 POSICAO NA GRADE; #27 #28 POSICAO FINAL; FURACAO SERPENTEANDO)
(CENTRO OMITIDO = 0; A OMITIDO = 0)
IF [#4 LT 1] GOTO900
IF [#5 LT 1] GOTO900
IF [#21 LE 0] GOTO900
IF [#22 LE 0] GOTO900
IF [#26 GE 0] GOTO900
IF [#9 LE 0] GOTO900
IF [#18 NE #0] GOTO10
#18=2
N10 IF [#17 LT 0] GOTO900
#6=0
G90 G17 G94
WHILE [#6 LT #5] DO1
 #10=0
 #12=#6-FIX[#6/2]*2
 WHILE [#10 LT #4] DO2
  #14=#10
  IF [#12 EQ 0] GOTO20
  #14=#4-1-#10
  N20 #15=#14*#21
  #16=#6*#22
  #27=#24+#15*COS[#1]-#16*SIN[#1]
  #28=#25+#15*SIN[#1]+#16*COS[#1]
  G00 Z#18
  G00 X#27 Y#28
  IF [#17 EQ #0] GOTO30
  G83 X#27 Y#28 Z#26 R#18 Q#17 F#9
  GOTO40
  N30 G81 X#27 Y#28 Z#26 R#18 F#9
  N40 G80
  #10=#10+1
 END2
 #6=#6+1
END1
G00 Z#18
M99
N900 #3000=3 (PARAMETRO GRADE INVALIDO)
M99
%
