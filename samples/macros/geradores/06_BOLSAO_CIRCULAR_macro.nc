%
O9015 (MACRO B - BOLSAO CIRCULAR - RASCUNHO)
(ENTRADAS G65: X=#24 Y=#25 W=#23 B=#2 D=#7 U=#21 E=#8 Z=#26 Q=#17 F=#9 S=#19)
(#2 DIAMETRO DO BOLSAO; #7 DIAMETRO FRESA; #21 SOBREMETAL NA PAREDE)
(#8 PASSO ENTRE ANEIS EM PERCENTUAL; #26 PROFUNDIDADE; #17 PASSE Z)
(#20 PROFUNDIDADE ATUAL; #3 RAIO MAXIMO; #10 PASSO; #11 NUMERO DE ANEIS)
(#23 Z INICIAL = TOPO DO BRUTO, W; #29 ALTURA SEGURA; OMITIDO = 0)
(#12 ANEL; #13 RAIO DO ANEL; #14 MENOS O RAIO; CENTRO OMITIDO = 0)
IF [#2 LE 0] GOTO900
IF [#7 LE 0] GOTO900
IF [#17 LE 0] GOTO900
IF [#26 GE #23] GOTO900
IF [#9 LE 0] GOTO900
IF [#19 LE 0] GOTO900
IF [#21 NE #0] GOTO10
#21=0.2
N10 IF [#21 LT 0] GOTO900
IF [#8 NE #0] GOTO20
#8=70
N20 IF [#8 LT 10] GOTO900
IF [#8 GT 100] GOTO900
IF [#2 LE [#7+2*#21]] GOTO900
#3=[#2-#7]/2-#21
#10=#7*#8/100
#11=FUP[#3/#10]
#29=#23+5
IF [#29 GE 5] GOTO801
#29=5
N801 #20=#23
G90 G17 G94
S#19 M03
G00 Z#29
G00 X#24 Y#25
WHILE [#20 GT #26] DO1
 #20=#20-#17
 IF [#20 GE #26] GOTO30
 #20=#26
 N30 G01 Z#20 F#9
 #12=1
 WHILE [#12 LE #11] DO2
  #13=#12*#10
  IF [#13 LE #3] GOTO40
  #13=#3
  N40 #14=0-#13
  G01 X[#24+#13] Y#25 F#9
  G03 X[#24+#13] Y#25 I#14 J0 F#9
  #12=#12+1
 END2
 G01 X#24 Y#25 F#9
END1
G00 Z#29
M99
N900 #3000=6 (PARAMETRO BOLSAO CIRCULAR INVALIDO)
M99
%
