<Project Sdk="Microsoft.NET.Sdk">

  <!-- Ferramenta de desenvolvimento: abre o CncStudio sem tela (headless) e salva fotos da
       interface. Roda no CI para conferir o visual. Não faz parte do programa distribuído. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="11.3.22" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CncStudio.App\CncStudio.App.csproj" />
  </ItemGroup>

</Project>
