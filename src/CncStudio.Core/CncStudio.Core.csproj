<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Núcleo do CncStudio: dialetos, lexer, parser, trajetória e simulação.
    Regra de arquitetura: este projeto NÃO referencia nenhuma biblioteca de UI
    e não tem dependências de pacotes NuGet.
  -->
  <PropertyGroup>
    <RootNamespace>CncStudio.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Macros dos geradores: o mesmo arquivo de samples/macros/geradores, embutido (uma fonte de verdade) -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\samples\macros\geradores\*_macro.nc" LogicalName="Macro.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CncStudio.Core.Tests" />
  </ItemGroup>

</Project>
