<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:CncStudio.App.Views"
             x:Class="CncStudio.App.Views.SimulationPanel">
  <DockPanel>

    <!-- Vistas -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
      <RadioButton x:Name="TopMode" GroupName="SimMode" Content="Superior" IsChecked="True" />
      <RadioButton x:Name="FrontMode" GroupName="SimMode" Content="Frontal" />
      <RadioButton x:Name="SideMode" GroupName="SimMode" Content="Lateral" />
      <RadioButton x:Name="IsoMode" GroupName="SimMode" Content="Isométrica" />
      <Button x:Name="FitButton" Content="Ajustar" Margin="8,0,0,0" />
    </StackPanel>

    <!-- Controles de execução -->
    <WrapPanel DockPanel.Dock="Top" Margin="0,4">
      <Button x:Name="PlayButton" Content="▶ Executar" Margin="0,0,4,4" MinWidth="100" />
      <Button x:Name="StepButton" Content="Passo (linha)" Margin="0,0,4,4" />
      <Button x:Name="EndButton" Content="Até o fim" Margin="0,0,4,4" />
      <Button x:Name="ResetButton" Content="Reiniciar" Margin="0,0,12,4" />
      <TextBlock Text="Velocidade" VerticalAlignment="Center" Margin="0,0,6,4" />
      <Slider x:Name="SpeedSlider" Minimum="0" Maximum="100" Value="50" Width="140" Margin="0,0,6,4" />
      <TextBlock x:Name="SpeedLabel" VerticalAlignment="Center" MinWidth="90" Margin="0,0,12,4" />
      <TextBlock Text="Ø ferramenta (mm)" VerticalAlignment="Center" Margin="0,0,6,4" />
      <NumericUpDown x:Name="ToolDiameterInput" Value="10" Minimum="0.1" Maximum="100" Increment="1"
                     FormatString="0.##" Width="120" Margin="0,0,0,4" />
    </WrapPanel>

    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" FontSize="12" Margin="4,2" />

    <views:SimulationView x:Name="View" />
  </DockPanel>
</UserControl>
