<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:CncStudio.App.Views"
             x:Class="CncStudio.App.Views.BackplotPanel">
  <DockPanel>

    <!-- Vistas + legenda de cores -->
    <WrapPanel DockPanel.Dock="Top" Margin="0,4">
      <RadioButton x:Name="PlaneXY" GroupName="BackplotPlane" Content="Superior (XY)" IsChecked="True" Margin="0,0,4,0" />
      <RadioButton x:Name="PlaneXZ" GroupName="BackplotPlane" Content="Frontal (XZ)" Margin="0,0,4,0" />
      <RadioButton x:Name="PlaneYZ" GroupName="BackplotPlane" Content="Lateral (YZ)" Margin="0,0,4,0" />
      <RadioButton x:Name="PlaneIso" GroupName="BackplotPlane" Content="Isométrica" Margin="0,0,4,0" />
      <RadioButton x:Name="PlaneLathe" GroupName="BackplotPlane" Content="Torno (ZX)" Margin="0,0,4,0" />
      <Button x:Name="FitButton" Content="Ajustar" Margin="8,0,0,0" />
      <ToggleButton x:Name="MeasureToggle" Content="📏 Medir" Margin="4,0,0,0"
                    ToolTip.Tip="Clique em dois pontos para medir (encaixa nos pontos da trajetória). Esc sai." />
      <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12">
        <Run Text="- - G00" Foreground="#FF4D4D" />
        <Run Text="   ── G01" Foreground="#3DDC6A" />
        <Run Text="   ── G02" Foreground="#7FD8FF" />
        <Run Text="   ── G03" Foreground="#3B6BFF" />
        <Run Text="   ── linha do cursor" Foreground="#FFE84D" />
      </TextBlock>
    </WrapPanel>

    <!-- Passe a passe: percorre a trajetória e mostra cada passe -->
    <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0" Spacing="2">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
          <Button x:Name="StartButton" Content="⏮" ToolTip.Tip="Início (nada executado)" />
          <Button x:Name="PreviousPassButton" Content="◀ Passe" ToolTip.Tip="Passe anterior (Page Up)" />
          <Button x:Name="PlayButton" Content="▶" MinWidth="36" ToolTip.Tip="Executar / pausar" />
          <Button x:Name="NextPassButton" Content="Passe ▶" ToolTip.Tip="Próximo passe (Page Down)" />
          <Button x:Name="EndButton" Content="⏭" ToolTip.Tip="Fim: mostra a trajetória inteira" />
        </StackPanel>
        <Slider x:Name="PositionSlider" Grid.Column="1" Minimum="0" Maximum="1" Margin="10,0"
                ToolTip.Tip="Arraste para qualquer ponto do programa" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
          <TextBlock Text="Velocidade" VerticalAlignment="Center" FontSize="12" />
          <Slider x:Name="SpeedSlider" Minimum="0" Maximum="100" Value="45" Width="100" />
        </StackPanel>
      </Grid>
      <TextBlock x:Name="StatusText" FontSize="12" Margin="2,0" />
    </StackPanel>

    <views:BackplotView x:Name="View" />
  </DockPanel>
</UserControl>
