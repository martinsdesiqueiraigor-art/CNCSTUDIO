<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CncStudio.App.Dialogs.StockDialog"
        Title="Bruto"
        Width="560" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <!-- DESK-01: montado no código (StockDialog.axaml.cs), igual ao setup do Code web: origem, forma, medidas e posição -->
  <StackPanel x:Name="Root" Margin="16" Spacing="10" />
</Window>
