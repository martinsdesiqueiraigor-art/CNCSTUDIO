<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CncStudio.App.Dialogs.ConfirmDialog"
        Title="Casillas Code"
        Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="18" Spacing="16">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14" />
    <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" />
  </StackPanel>
</Window>
