<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="using:AvaloniaEdit"
        xmlns:views="using:CncStudio.App.Views"
        x:Class="CncStudio.App.MainWindow"
        Title="CncStudio"
        Width="1280" Height="800"
        MinWidth="800" MinHeight="500">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Barra de ferramentas -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="8,6">
      <Button x:Name="OpenButton" Content="Abrir (Ctrl+O)" />
      <Button x:Name="SaveButton" Content="Salvar (Ctrl+S)" />
      <Button x:Name="FanucSampleButton" Content="Exemplo Fanuc" />
      <Button x:Name="SiemensSampleButton" Content="Exemplo Siemens" />
      <TextBlock Text="Dialeto:" VerticalAlignment="Center" Margin="12,0,0,0" />
      <ComboBox x:Name="DialectCombo" Width="120" SelectedIndex="0">
        <ComboBoxItem Content="Fanuc" />
        <ComboBoxItem Content="Siemens" />
      </ComboBox>
    </StackPanel>

    <!-- Área principal: editor à esquerda, painéis gráficos à direita -->
    <Grid Grid.Row="1" ColumnDefinitions="2*,4,3*">

      <Grid Grid.Column="0" RowDefinitions="*,4,120">
        <ae:TextEditor x:Name="Editor"
                       Grid.Row="0"
                       ShowLineNumbers="True"
                       FontFamily="Cascadia Mono, Consolas, Menlo, monospace"
                       FontSize="14"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto" />
        <GridSplitter Grid.Row="1" ResizeDirection="Rows" />
        <!-- Painel de diagnósticos: clique para ir à linha -->
        <ListBox x:Name="DiagnosticsList" Grid.Row="2" FontSize="12" />
      </Grid>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

      <TabControl x:Name="ViewTabs" Grid.Column="2" Margin="4,0,0,0">
        <TabItem Header="Backplot">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,4">
              <RadioButton x:Name="BackplotXY" GroupName="BackplotPlane" Content="Superior (XY)" IsChecked="True" />
              <RadioButton x:Name="BackplotXZ" GroupName="BackplotPlane" Content="Frontal (XZ)" />
              <RadioButton x:Name="BackplotYZ" GroupName="BackplotPlane" Content="Lateral (YZ)" />
              <Button x:Name="BackplotFitButton" Content="Ajustar" Margin="8,0,0,0" />
              <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12">
                <Run Text="- - G00" Foreground="#E0A030" />
                <Run Text="   ── corte" Foreground="#3CC8FF" />
                <Run Text="   ── linha do cursor" Foreground="#FFE84D" />
              </TextBlock>
            </StackPanel>
            <views:BackplotView x:Name="Backplot" />
          </DockPanel>
        </TabItem>
        <TabItem Header="Simulação">
          <views:SimulationPanel x:Name="Simulation" />
        </TabItem>
      </TabControl>
    </Grid>

    <!-- Barra de status -->
    <Border Grid.Row="2" Padding="8,3" Background="#1E1E1E">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock x:Name="AnalysisStatus" Grid.Column="0" FontSize="12" />
        <TextBlock x:Name="CaretStatus" Grid.Column="1" FontSize="12" Margin="16,0" />
        <TextBlock x:Name="FileStatus" Grid.Column="2" FontSize="12" />
      </Grid>
    </Border>
  </Grid>
</Window>
