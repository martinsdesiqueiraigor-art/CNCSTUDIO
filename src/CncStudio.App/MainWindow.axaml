<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="using:AvaloniaEdit"
        xmlns:views="using:CncStudio.App.Views"
        xmlns:controls="using:CncStudio.App.Controls"
        xmlns:graphics="using:CncStudio.App.Graphics"
        x:Class="CncStudio.App.MainWindow"
        Title="CncStudio"
        Icon="/Assets/cncstudio.ico"
        Width="1280" Height="800"
        MinWidth="800" MinHeight="500">

  <Window.Styles>
    <!-- Faixa de comandos: grupos com moldura e rótulo embaixo, como no CIMCO -->
    <Style Selector="StackPanel.ribbon">
      <Setter Property="Margin" Value="4,2,4,4" />
      <Setter Property="Spacing" Value="6" />
    </Style>
    <Style Selector="Border.group">
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,4,6,2" />
    </Style>
    <!-- Abas dos programas abertos -->
    <Style Selector="Border.documentTab">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.documentTab:pointerover">
      <Setter Property="Background" Value="{DynamicResource TabHoverBackground}" />
    </Style>
    <Style Selector="Border.documentTab.active">
      <Setter Property="Background" Value="{DynamicResource TabActiveBackground}" />
    </Style>
    <Style Selector="TextBlock.groupLabel">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Faixa de comandos em abas (estilo "ribbon") + dialeto sempre visível -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Background="{DynamicResource RibbonBackground}">
      <TabControl x:Name="Ribbon" Grid.Column="0" Padding="0">
        <TabItem Header="Arquivo">
          <StackPanel Orientation="Horizontal" Classes="ribbon">
            <Border Classes="group">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button x:Name="NewButton" Classes="ribbon" ToolTip.Tip="Programa novo em outra aba (Ctrl+N)"><StackPanel><PathIcon Data="{StaticResource IconNew}" /><TextBlock Text="Novo" /></StackPanel></Button>
                  <Button x:Name="OpenButton" Classes="ribbon" ToolTip.Tip="Abrir programa (Ctrl+O)"><StackPanel><PathIcon Data="{StaticResource IconOpen}" /><TextBlock Text="Abrir" /></StackPanel></Button>
                  <Button x:Name="RecentButton" Classes="ribbon" ToolTip.Tip="Arquivos abertos recentemente"><StackPanel><PathIcon Data="{StaticResource IconRecent}" /><TextBlock Text="Recentes ▾" /></StackPanel></Button>
                  <Button x:Name="SaveButton" Classes="ribbon" ToolTip.Tip="Salvar (Ctrl+S)"><StackPanel><PathIcon Data="{StaticResource IconSave}" /><TextBlock Text="Salvar" /></StackPanel></Button>
                  <Button x:Name="SaveAsButton" Classes="ribbon" ToolTip.Tip="Salvar com outro nome (Ctrl+Shift+S)"><StackPanel><PathIcon Data="{StaticResource IconSaveAs}" /><TextBlock Text="Salvar como…" /></StackPanel></Button>
                </StackPanel>
                <TextBlock Classes="groupLabel" Text="Arquivo" />
              </StackPanel>
            </Border>
            <Border Classes="group">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button x:Name="FanucSampleButton" Classes="ribbon" ToolTip.Tip="Abrir EXEMPLO.nc"><StackPanel><PathIcon Data="{StaticResource IconProgram}" /><TextBlock Text="Fanuc" /></StackPanel></Button>
                  <Button x:Name="SiemensSampleButton" Classes="ribbon" ToolTip.Tip="Abrir EXEMPLO.mpf"><StackPanel><PathIcon Data="{StaticResource IconProgram}" /><TextBlock Text="Siemens" /></StackPanel></Button>
                  <Button x:Name="LatheFanucSampleButton" Classes="ribbon" ToolTip.Tip="Abrir torno/EXEMPLO_TORNO.nc (G71, G70, G76)"><StackPanel><PathIcon Data="{StaticResource IconLathe}" /><TextBlock Text="Torno Fanuc" /></StackPanel></Button>
                  <Button x:Name="LatheSiemensSampleButton" Classes="ribbon" ToolTip.Tip="Abrir torno/EXEMPLO_TORNO.mpf (CYCLE95, CYCLE97)"><StackPanel><PathIcon Data="{StaticResource IconLathe}" /><TextBlock Text="Torno Siemens" /></StackPanel></Button>
                  <Button x:Name="MoreSamplesButton" Classes="ribbon" ToolTip.Tip="Abrir a pasta de exemplos (furação, macros)"><StackPanel><PathIcon Data="{StaticResource IconFolder}" /><TextBlock Text="Outros…" /></StackPanel></Button>
                </StackPanel>
                <TextBlock Classes="groupLabel" Text="Exemplos" />
              </StackPanel>
            </Border>
            <Border Classes="group">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button x:Name="SetupSheetButton" Classes="ribbon"
                          ToolTip.Tip="Informações do programa, ferramentas e tempos; abre no navegador para imprimir ou salvar em PDF"><StackPanel><PathIcon Data="{StaticResource IconSheet}" /><TextBlock Text="Folha de setup" /></StackPanel></Button>
                  <Button x:Name="CompareButton" Classes="ribbon"
                          ToolTip.Tip="Compara o programa do editor com outro arquivo, lado a lado"><StackPanel><PathIcon Data="{StaticResource IconCompare}" /><TextBlock Text="Comparar…" /></StackPanel></Button>
                </StackPanel>
                <TextBlock Classes="groupLabel" Text="Relatórios" />
              </StackPanel>
            </Border>
          </StackPanel>
        </TabItem>

        <TabItem Header="Editar">
          <StackPanel Orientation="Horizontal" Classes="ribbon">
            <Border Classes="group">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button x:Name="UndoButton" Classes="ribbon" ToolTip.Tip="Ctrl+Z"><StackPanel><PathIcon Data="{StaticResource IconUndo}" /><TextBlock Text="Desfazer" /></StackPanel></Button>
                  <Button x:Name="RedoButton" Classes="ribbon" ToolTip.Tip="Ctrl+Y"><StackPanel><PathIcon Data="{StaticResource IconRedo}" /><TextBlock Text="Refazer" /></StackPanel></Button>
                </StackPanel>
                <TextBlock Classes="groupLabel" Text="Histórico" />
              </StackPanel>
            </Border>
            <Border Classes="group">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button x:Name="FindButton" Classes="ribbon" ToolTip.Tip="Ctrl+F (F3 = próximo)"><StackPanel><PathIcon Data="{StaticResource IconFind}" /><TextBlock Text="Procurar" /></StackPanel></Button>
                  <Button x:Name="ReplaceButton" Classes="ribbon" ToolTip.Tip="Ctrl+H"><StackPanel><PathIcon Data="{StaticResource IconReplace}" /><TextBlock Text="Substituir" /></StackPanel></Button>
                  <Button x:Name="GoToLineButton" Classes="ribbon" ToolTip.Tip="Ctrl+G"><StackPanel><PathIcon Data="{StaticResource IconGoTo}" /><TextBlock Text="Ir para linha" /></StackPanel></Button>
                </StackPanel>
                <TextBlock Classes="groupLabel" Text="Localizar" />
              </StackPanel>
            </Border>
            <Border Classes="group">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button x:Name="FontSmallerButton" Content="A−" ToolTip.Tip="Diminuir fonte (Ctrl + −)" />
                  <TextBlock x:Name="FontSizeText" VerticalAlignment="Center" MinWidth="40" TextAlignment="Center" />
                  <Button x:Name="FontLargerButton" Content="A+" ToolTip.Tip="Aumentar fonte (Ctrl + +, ou Ctrl + roda do mouse)" />
                </StackPanel>
                <TextBlock Classes="groupLabel" Text="Fonte" />
              </StackPanel>
            </Border>
            <Border Classes="group">
              <StackPanel>
                <CheckBox x:Name="CodeHelpCheck" Content="Explicar código ao parar o mouse"
                          ToolTip.Tip="Mostra o que é G71, CYCLE83, #3000... e os parâmetros" />
                <TextBlock Classes="groupLabel" Text="Ajuda" />
              </StackPanel>
            </Border>
          </StackPanel>
        </TabItem>

        <TabItem Header="Funções NC">
          <StackPanel Orientation="Horizontal" Classes="ribbon">
            <Border Classes="group">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button x:Name="RenumberButton" Classes="ribbon"><StackPanel><PathIcon Data="{StaticResource IconRenumber}" /><TextBlock Text="Renumerar blocos…" /></StackPanel></Button>
                  <Button x:Name="UppercaseButton" Classes="ribbon" ToolTip.Tip="Converte tudo, exceto comentários"><StackPanel><PathIcon Data="{StaticResource IconUpper}" /><TextBlock Text="Maiúsculas" /></StackPanel></Button>
                  <Button x:Name="RemoveBlockNumbersButton" Classes="ribbon" ToolTip.Tip="Remove todos os números de bloco"><StackPanel><PathIcon Data="{StaticResource IconRemoveN}" /><TextBlock Text="Remover N" /></StackPanel></Button>
                </StackPanel>
                <TextBlock Classes="groupLabel" Text="Blocos" />
              </StackPanel>
            </Border>
            <Border Classes="group">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button x:Name="RemoveSpacesButton" Classes="ribbon" ToolTip.Tip="N10 G01 X10 → N10G01X10 (comentários e IF/GOTO ficam como estão)"><StackPanel><PathIcon Data="{StaticResource IconRemoveSpaces}" /><TextBlock Text="Remover espaços" /></StackPanel></Button>
                  <Button x:Name="InsertSpacesButton" Classes="ribbon" ToolTip.Tip="N10G01X10 → N10 G01 X10"><StackPanel><PathIcon Data="{StaticResource IconInsertSpaces}" /><TextBlock Text="Inserir espaços" /></StackPanel></Button>
                  <Button x:Name="RemoveCommentsButton" Classes="ribbon" ToolTip.Tip="Linhas que só tinham comentário são apagadas"><StackPanel><PathIcon Data="{StaticResource IconRemoveComments}" /><TextBlock Text="Remover comentários" /></StackPanel></Button>
                </StackPanel>
                <TextBlock Classes="groupLabel" Text="Texto" />
              </StackPanel>
            </Border>
          </StackPanel>
        </TabItem>
        <TabItem Header="Máquina">
          <StackPanel Orientation="Horizontal" Classes="ribbon">
            <Border Classes="group">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button x:Name="MachineSettingsButton" Classes="ribbon"
                          ToolTip.Tip="Diâmetros das ferramentas, G54–G59 e números sem ponto no Fanuc"><StackPanel><PathIcon Data="{StaticResource IconTool}" /><TextBlock Text="Ferramentas e zeros…" /></StackPanel></Button>
                  <Button x:Name="StockSettingsButton" Classes="ribbon"
                          ToolTip.Tip="Medidas do bruto deste programa (bloco na fresa, barra no torno)"><StackPanel><PathIcon Data="{StaticResource IconStock}" /><TextBlock Text="Bruto…" /></StackPanel></Button>
                </StackPanel>
                <TextBlock Classes="groupLabel" Text="Configuração" />
              </StackPanel>
            </Border>
          </StackPanel>
        </TabItem>
      </TabControl>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="8,0" VerticalAlignment="Center">
        <TextBlock Text="Máquina" VerticalAlignment="Center" />
        <ComboBox x:Name="MachineCombo" Width="150" SelectedIndex="0"
                  ToolTip.Tip="Automático: descobre pelo programa (G71, U/W, CYCLE95... = torno)">
          <ComboBoxItem Content="Automático" />
          <ComboBoxItem Content="Fresa" />
          <ComboBoxItem Content="Torno" />
        </ComboBox>
        <TextBlock Text="Dialeto" VerticalAlignment="Center" Margin="8,0,0,0" />
        <ComboBox x:Name="DialectCombo" Width="120" SelectedIndex="0">
          <ComboBoxItem Content="Fanuc" />
          <ComboBoxItem Content="Siemens" />
        </ComboBox>
        <Button x:Name="ThemeButton" Content="☀" Margin="8,0,0,0" ToolTip.Tip="Tema claro / escuro" />
      </StackPanel>
    </Grid>

    <!-- Área principal: editor à esquerda, painéis gráficos à direita -->
    <Grid Grid.Row="1" ColumnDefinitions="2*,4,3*">

      <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,4,140">
        <!-- Abas dos programas abertos (Ctrl+Tab troca, Ctrl+W fecha, botão do meio fecha) -->
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel x:Name="TabStrip" Orientation="Horizontal" Margin="0,2,0,0" />
        </ScrollViewer>
        <controls:SearchBar x:Name="Search" Grid.Row="1" />
        <ae:TextEditor x:Name="Editor"
                       Grid.Row="2"
                       ShowLineNumbers="True"
                       FontFamily="Cascadia Mono, Consolas, Menlo, monospace"
                       FontSize="14"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto" />
        <GridSplitter Grid.Row="3" ResizeDirection="Rows" />
        <!-- Painel de diagnósticos: filtro por tipo e contagem; clique para ir à linha -->
        <DockPanel Grid.Row="4">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,2">
            <ToggleButton x:Name="ShowErrorsToggle" IsChecked="True" FontSize="12" Padding="8,2"
                          ToolTip.Tip="Mostrar/esconder erros" />
            <ToggleButton x:Name="ShowWarningsToggle" IsChecked="True" FontSize="12" Padding="8,2"
                          ToolTip.Tip="Mostrar/esconder avisos" />
            <TextBlock x:Name="DiagnosticsHint" VerticalAlignment="Center" FontSize="11" Opacity="0.6" Margin="6,0,0,0" />
          </StackPanel>
          <ListBox x:Name="DiagnosticsList" FontSize="12" Background="{DynamicResource PanelBackground}" />
        </DockPanel>
      </Grid>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

      <TabControl x:Name="ViewTabs" Grid.Column="2" Margin="4,0,0,0">
        <TabItem Header="Gráfico">
          <graphics:GraphicsPanel x:Name="Graphics" />
        </TabItem>
        <TabItem Header="Estatísticas">
          <views:StatisticsPanel x:Name="Statistics" />
        </TabItem>
      </TabControl>
    </Grid>

    <!-- Barra de status -->
    <Border Grid.Row="2" Padding="8,3" Background="{DynamicResource StatusBackground}">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock x:Name="AnalysisStatus" Grid.Column="0" FontSize="12" />
        <TextBlock x:Name="CaretStatus" Grid.Column="1" FontSize="12" Margin="16,0" />
        <TextBlock x:Name="FileStatus" Grid.Column="2" FontSize="12" />
      </Grid>
    </Border>
  </Grid>
</Window>
