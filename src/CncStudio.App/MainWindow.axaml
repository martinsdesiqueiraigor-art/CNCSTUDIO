<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="using:AvaloniaEdit"
        xmlns:views="using:CncStudio.App.Views"
        xmlns:controls="using:CncStudio.App.Controls"
        xmlns:graphics="using:CncStudio.App.Graphics"
        xmlns:modules="using:CncStudio.App.Modules"
        x:Class="CncStudio.App.MainWindow"
        Title="Casillas Code"
        Icon="/Assets/casillas-code.ico"
        Width="1280" Height="800"
        MinWidth="800" MinHeight="500">

  <Window.Styles>
    <!-- Botões só de ícone da barra de cima -->
    <Style Selector="Button.tool, ToggleButton.tool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="MinWidth" Value="32" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool PathIcon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Foreground" Value="{DynamicResource RibbonIcon}" />
    </Style>
    <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TabActiveBackground}" />
    </Style>
    <Style Selector="Border.sep">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="Background" Value="{DynamicResource SubtleBorder}" />
    </Style>
    <!-- Abas dos programas abertos -->
    <Style Selector="Border.documentTab">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.documentTab:pointerover">
      <Setter Property="Background" Value="{DynamicResource TabHoverBackground}" />
    </Style>
    <Style Selector="Border.documentTab.active">
      <Setter Property="Background" Value="{DynamicResource TabActiveBackground}" />
    </Style>
  </Window.Styles>

  <!-- Barra lateral de módulos + conteúdo. O Code continua sendo a grade logo abaixo; o Início fica por cima dela. -->
  <Grid ColumnDefinitions="Auto,*">
    <Border Grid.Column="0" Background="{DynamicResource RibbonBackground}" Width="76"
            BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,0,1,0">
      <DockPanel LastChildFill="False">
        <StackPanel x:Name="ModuleRail" DockPanel.Dock="Top" Spacing="4" Margin="6,8" />
        <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="6,8">
          <ToggleButton x:Name="CmykButton" Classes="tool" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        ToolTip.Tip="Tema CMYK (ciano, magenta, amarelo)">
            <TextBlock Text="CMYK" FontSize="11" FontWeight="Bold" />
          </ToggleButton>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
    <modules:HomeView x:Name="Home" ZIndex="10" IsVisible="False" Background="{DynamicResource PanelBackground}" />
    <modules:MacroView x:Name="Macro" ZIndex="10" IsVisible="False" Background="{DynamicResource PanelBackground}" />
    <modules:OptimizerView x:Name="Optimizer" ZIndex="10" IsVisible="False" Background="{DynamicResource PanelBackground}" />
  <Grid x:Name="CodeRoot" RowDefinitions="Auto,*,Auto">

    <!-- Barra fina: só ícones (o nome aparece ao passar o mouse); Máquina e Dialeto pequenos à direita -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Background="{DynamicResource RibbonBackground}" Height="38">
      <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="2" Margin="6,0" VerticalAlignment="Center">
          <Image Source="/Assets/simbolo.png" Height="20" Margin="0,0,6,0" ToolTip.Tip="Casillas Code" />
          <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold" FontSize="14">
            <Run Text="Casillas" /><Run Text=" Code" Foreground="#58A6FF" />
          </TextBlock>

          <Button x:Name="NewButton" Classes="tool" ToolTip.Tip="Novo: programa novo em outra aba (Ctrl+N)"><PathIcon Data="{StaticResource IconNew}" /></Button>
          <Button x:Name="OpenButton" Classes="tool" ToolTip.Tip="Abrir programa (Ctrl+O)"><PathIcon Data="{StaticResource IconOpen}" /></Button>
          <Button x:Name="RecentButton" Classes="tool" ToolTip.Tip="Arquivos abertos recentemente"><PathIcon Data="{StaticResource IconRecent}" /></Button>
          <Button x:Name="SaveButton" Classes="tool" ToolTip.Tip="Salvar (Ctrl+S)"><PathIcon Data="{StaticResource IconSave}" /></Button>
          <Button x:Name="SaveAsButton" Classes="tool" ToolTip.Tip="Salvar como… (Ctrl+Shift+S)"><PathIcon Data="{StaticResource IconSaveAs}" /></Button>
          <Border Classes="sep" />

          <Button x:Name="ExamplesButton" Classes="tool" ToolTip.Tip="Exemplos">
            <StackPanel Orientation="Horizontal" Spacing="2"><PathIcon Data="{StaticResource IconProgram}" /><TextBlock Text="▾" FontSize="10" VerticalAlignment="Center" /></StackPanel>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem x:Name="FanucSampleButton" Header="Fresa Fanuc (EXEMPLO.nc)" />
                <MenuItem x:Name="SiemensSampleButton" Header="Fresa Siemens (EXEMPLO.mpf)" />
                <MenuItem x:Name="LatheFanucSampleButton" Header="Torno Fanuc (G71, G70, G76)" />
                <MenuItem x:Name="LatheSiemensSampleButton" Header="Torno Siemens (CYCLE95, CYCLE97)" />
                <Separator />
                <MenuItem x:Name="MoreSamplesButton" Header="Outros… (pasta de exemplos: furação, macros)" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button x:Name="SetupSheetButton" Classes="tool" ToolTip.Tip="Folha de setup: informações, ferramentas e tempos; abre no navegador para imprimir ou salvar em PDF"><PathIcon Data="{StaticResource IconSheet}" /></Button>
          <Button x:Name="CompareButton" Classes="tool" ToolTip.Tip="Comparar o programa do editor com outro arquivo, lado a lado"><PathIcon Data="{StaticResource IconCompare}" /></Button>
          <Border Classes="sep" />

          <Button x:Name="UndoButton" Classes="tool" ToolTip.Tip="Desfazer (Ctrl+Z)"><PathIcon Data="{StaticResource IconUndo}" /></Button>
          <Button x:Name="RedoButton" Classes="tool" ToolTip.Tip="Refazer (Ctrl+Y)"><PathIcon Data="{StaticResource IconRedo}" /></Button>
          <Button x:Name="FindButton" Classes="tool" ToolTip.Tip="Procurar (Ctrl+F; F3 = próximo)"><PathIcon Data="{StaticResource IconFind}" /></Button>
          <Button x:Name="ReplaceButton" Classes="tool" ToolTip.Tip="Substituir (Ctrl+H)"><PathIcon Data="{StaticResource IconReplace}" /></Button>
          <Button x:Name="GoToLineButton" Classes="tool" ToolTip.Tip="Ir para a linha (Ctrl+G)"><PathIcon Data="{StaticResource IconGoTo}" /></Button>
          <Border Classes="sep" />

          <Button x:Name="FontSmallerButton" Classes="tool" Content="A−" ToolTip.Tip="Diminuir a fonte (Ctrl + −)" />
          <TextBlock x:Name="FontSizeText" VerticalAlignment="Center" FontSize="11" Opacity="0.7" MinWidth="34" TextAlignment="Center" />
          <Button x:Name="FontLargerButton" Classes="tool" Content="A+" ToolTip.Tip="Aumentar a fonte (Ctrl + +, ou Ctrl + roda do mouse)" />
          <ToggleButton x:Name="CodeHelpCheck" Classes="tool" Content="?" FontWeight="Bold"
                        ToolTip.Tip="Explicar o código ao parar o mouse: mostra o que é G71, CYCLE83, #3000... e os parâmetros" />
          <Border Classes="sep" />

          <Button x:Name="NcFunctionsButton" Classes="tool" ToolTip.Tip="Funções NC: renumerar, maiúsculas, espaços e comentários">
            <StackPanel Orientation="Horizontal" Spacing="2"><PathIcon Data="{StaticResource IconRenumber}" /><TextBlock Text="▾" FontSize="10" VerticalAlignment="Center" /></StackPanel>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem x:Name="RenumberButton" Header="Renumerar blocos…" />
                <MenuItem x:Name="UppercaseButton" Header="Maiúsculas (exceto comentários)" />
                <MenuItem x:Name="RemoveBlockNumbersButton" Header="Remover números de bloco (N)" />
                <Separator />
                <MenuItem x:Name="RemoveSpacesButton" Header="Remover espaços (N10G01X10)" />
                <MenuItem x:Name="InsertSpacesButton" Header="Inserir espaços (N10 G01 X10)" />
                <MenuItem x:Name="RemoveCommentsButton" Header="Remover comentários" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <!-- Ferramentas de simulação: só aparecem com o gráfico aberto -->
          <StackPanel x:Name="SimulationTools" Orientation="Horizontal" Spacing="2">
            <Border Classes="sep" />
            <Button x:Name="MachineSettingsButton" Classes="tool" ToolTip.Tip="Ferramentas e zeros: diâmetros, G54–G59 e números sem ponto no Fanuc"><PathIcon Data="{StaticResource IconTool}" /></Button>
            <Button x:Name="StockSettingsButton" Classes="tool" ToolTip.Tip="Bruto: medidas deste programa (bloco na fresa, barra no torno)"><PathIcon Data="{StaticResource IconStock}" /></Button>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="6,0" VerticalAlignment="Center">
        <ComboBox x:Name="MachineCombo" Width="112" FontSize="12" MinHeight="26" Padding="8,2" SelectedIndex="0"
                  ToolTip.Tip="Máquina. Automático: descobre pelo programa (G71, U/W, CYCLE95... = torno)">
          <ComboBoxItem Content="Automático" />
          <ComboBoxItem Content="Fresa" />
          <ComboBoxItem Content="Torno" />
        </ComboBox>
        <ComboBox x:Name="DialectCombo" Width="92" FontSize="12" MinHeight="26" Padding="8,2" SelectedIndex="0" ToolTip.Tip="Dialeto">
          <ComboBoxItem Content="Fanuc" />
          <ComboBoxItem Content="Siemens" />
        </ComboBox>
        <Button x:Name="ThemeButton" Classes="tool" Content="☀" ToolTip.Tip="Tema claro / escuro" />
      </StackPanel>
    </Grid>

    <!-- Área principal: editor à esquerda, painéis gráficos à direita -->
    <Grid x:Name="MainArea" Grid.Row="1" ColumnDefinitions="2*,4,3*">

      <Grid x:Name="EditorPane" Grid.Column="0" RowDefinitions="Auto,Auto,*,4,140">
        <!-- Abas dos programas abertos (Ctrl+Tab troca, Ctrl+W fecha, botão do meio fecha) -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
          <ScrollViewer x:Name="TabScroll" Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="TabStrip" Orientation="Horizontal" Margin="0,2,0,0" />
          </ScrollViewer>
          <!-- Seta no topo das abas: recolhe o editor e deixa o gráfico com a tela toda -->
          <Button x:Name="CollapseEditorButton" Grid.Column="1" Classes="tool" Content="◀"
                  ToolTip.Tip="Recolher o editor (F4)" />
        </Grid>
        <controls:SearchBar x:Name="Search" Grid.Row="1" />
        <ae:TextEditor x:Name="Editor"
                       Grid.Row="2"
                       ShowLineNumbers="True"
                       FontFamily="Cascadia Mono, Consolas, Menlo, monospace"
                       FontSize="14"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto" />
        <GridSplitter Grid.Row="3" ResizeDirection="Rows" />
        <!-- Painel de diagnósticos: filtro por tipo e contagem; clique para ir à linha -->
        <DockPanel Grid.Row="4">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,2">
            <ToggleButton x:Name="ShowErrorsToggle" IsChecked="True" FontSize="12" Padding="8,2"
                          ToolTip.Tip="Mostrar/esconder erros" />
            <ToggleButton x:Name="ShowWarningsToggle" IsChecked="True" FontSize="12" Padding="8,2"
                          ToolTip.Tip="Mostrar/esconder avisos" />
            <TextBlock x:Name="DiagnosticsHint" VerticalAlignment="Center" FontSize="11" Opacity="0.6" Margin="6,0,0,0" />
          </StackPanel>
          <ListBox x:Name="DiagnosticsList" FontSize="12" Background="{DynamicResource PanelBackground}" />
        </DockPanel>
      </Grid>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

      <TabControl x:Name="ViewTabs" Grid.Column="2" Margin="4,0,0,0">
        <TabItem Header="Gráfico">
          <graphics:GraphicsPanel x:Name="Graphics" />
        </TabItem>
        <TabItem Header="Estatísticas">
          <views:StatisticsPanel x:Name="Statistics" />
        </TabItem>
      </TabControl>
    </Grid>

    <!-- Barra de status -->
    <Border Grid.Row="2" Padding="8,3" Background="{DynamicResource StatusBackground}">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock x:Name="AnalysisStatus" Grid.Column="0" FontSize="12" />
        <TextBlock x:Name="CaretStatus" Grid.Column="1" FontSize="12" Margin="16,0" />
        <TextBlock x:Name="FileStatus" Grid.Column="2" FontSize="12" />
      </Grid>
    </Border>
  </Grid>
    </Grid>
  </Grid>
</Window>
