<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CncStudio.App.App"
             RequestedThemeVariant="Dark">
  <!-- Cores que mudam com o tema (claro/escuro). Os gráficos (backplot/simulação) ficam sempre escuros. -->
  <Application.Resources>
    <ResourceDictionary>
      <!-- Ícones da faixa de comandos (desenhos próprios, grade 24×24) -->
      <StreamGeometry x:Key="IconNew">F0 M5,2 H14 L19,7 V22 H5 Z M7,4 V20 H17 V8 H13 V4 Z</StreamGeometry>
      <StreamGeometry x:Key="IconOpen">F0 M2,5 H9 L11,7 H22 V20 H2 Z M4,9 V18 H20 V9 Z</StreamGeometry>
      <StreamGeometry x:Key="IconRecent">F0 M12,2 A10,10 0 1 1 11.99,2 Z M12,4 A8,8 0 1 0 12.01,4 Z M11,6 H13 V11 H17 V13 H11 Z</StreamGeometry>
      <StreamGeometry x:Key="IconSave">F0 M3,3 H18 L21,6 V21 H3 Z M6,5 V10 H16 V5 Z M7,14 V19 H17 V14 Z</StreamGeometry>
      <StreamGeometry x:Key="IconSaveAs">F0 M3,3 H16 L19,6 V12 H17 V7 L15,5 H14 V9 H6 V5 H5 V19 H12 V21 H3 Z M13,16 L19,10 L21,12 L15,18 L13,18 Z</StreamGeometry>
      <StreamGeometry x:Key="IconProgram">F0 M5,2 H19 V22 H5 Z M7,4 V20 H17 V4 Z M9,7 H15 V9 H9 Z M9,11 H15 V13 H9 Z M9,15 H13 V17 H9 Z</StreamGeometry>
      <StreamGeometry x:Key="IconLathe">F1 M2,9 H9 V7 H16 V9 H22 V15 H16 V17 H9 V15 H2 Z</StreamGeometry>
      <StreamGeometry x:Key="IconFolder">F0 M2,5 H9 L11,7 H22 V20 H2 Z M4,9 V18 H20 V9 Z</StreamGeometry>
      <StreamGeometry x:Key="IconSheet">F0 M6,4 H9 V2 H15 V4 H18 V22 H6 Z M8,6 V20 H16 V6 Z M10,9 H14 V11 H10 Z M10,13 H14 V15 H10 Z</StreamGeometry>
      <StreamGeometry x:Key="IconCompare">F0 M2,4 H10 V20 H2 Z M4,6 V18 H8 V6 Z M14,4 H22 V20 H14 Z M16,6 V18 H20 V6 Z M11,11 H13 V13 H11 Z</StreamGeometry>
      <StreamGeometry x:Key="IconUndo">F1 M3,10 L9,4 V8 H14 A6,6 0 0 1 14,20 H9 V17 H14 A3,3 0 0 0 14,11 H9 V16 Z</StreamGeometry>
      <StreamGeometry x:Key="IconRedo">F1 M21,10 L15,4 V8 H10 A6,6 0 0 0 10,20 H15 V17 H10 A3,3 0 0 1 10,11 H15 V16 Z</StreamGeometry>
      <StreamGeometry x:Key="IconFind">F0 M10,2 A8,8 0 1 1 9.99,2 Z M10,5 A5,5 0 1 0 10.01,5 Z M15,16.5 L16.5,15 L22,20.5 L20.5,22 Z</StreamGeometry>
      <StreamGeometry x:Key="IconReplace">F1 M3,7 H15 V4 L20,8 L15,12 V9 H3 Z M21,17 H9 V20 L4,16 L9,12 V15 H21 Z</StreamGeometry>
      <StreamGeometry x:Key="IconGoTo">F1 M2,11 H14 V8 L19,12 L14,16 V13 H2 Z M20,4 H22 V20 H20 Z</StreamGeometry>
      <StreamGeometry x:Key="IconRenumber">F1 M3,4 H6 V7 H3 Z M3,10.5 H6 V13.5 H3 Z M3,17 H6 V20 H3 Z M8,5 H21 V6.5 H8 Z M8,11.5 H21 V13 H8 Z M8,18 H21 V19.5 H8 Z</StreamGeometry>
      <StreamGeometry x:Key="IconUpper">F0 M4,20 L10,4 H14 L20,20 H17 L15.5,16 H8.5 L7,20 Z M9.5,13 H14.5 L12,6.5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconRemoveN">F1 M3,4 H6 V7 H3 Z M3,17 H6 V20 H3 Z M8,5 H21 V6.5 H8 Z M8,18 H21 V19.5 H8 Z M2,11 H22 V13 H2 Z</StreamGeometry>
      <StreamGeometry x:Key="IconRemoveSpaces">F1 M2,8 L7,12 L2,16 Z M22,8 L17,12 L22,16 Z M11,4 H13 V20 H11 Z</StreamGeometry>
      <StreamGeometry x:Key="IconInsertSpaces">F1 M8,8 L3,12 L8,16 Z M16,8 L21,12 L16,16 Z M11,4 H13 V20 H11 Z</StreamGeometry>
      <StreamGeometry x:Key="IconRemoveComments">F0 M3,4 H21 V16 H9 L5,20 V16 H3 Z M5,6 V14 H19 V6 Z M9,7.5 L10.5,6 L15,10.5 L13.5,12 Z M13.5,6 L15,7.5 L10.5,12 L9,10.5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconTool">F1 M9,2 H15 V7 H9 Z M10,8 H14 V19 L12,22 L10,19 Z</StreamGeometry>
      <StreamGeometry x:Key="IconStock">F0 M12,2 L21,7 V17 L12,22 L3,17 V7 Z M12,4.3 L5.3,8 L12,11.7 L18.7,8 Z</StreamGeometry>

      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="RibbonBackground" Color="#202329" />
          <SolidColorBrush x:Key="PanelBackground" Color="#1B1D22" />
          <SolidColorBrush x:Key="CardBackground" Color="#23262C" />
          <SolidColorBrush x:Key="StatusBackground" Color="#1E1E1E" />
          <SolidColorBrush x:Key="SubtleBorder" Color="#3A3F47" />
          <SolidColorBrush x:Key="TabHoverBackground" Color="#2A2E35" />
          <SolidColorBrush x:Key="TabActiveBackground" Color="#33404F" />
          <SolidColorBrush x:Key="HighlightText" Color="#FFE84D" />
          <SolidColorBrush x:Key="CuttingText" Color="#3CC8FF" />
          <SolidColorBrush x:Key="RapidText" Color="#E0A030" />
          <SolidColorBrush x:Key="LegendG00" Color="#FF4D4D" />
          <SolidColorBrush x:Key="LegendG01" Color="#3DDC6A" />
          <SolidColorBrush x:Key="LegendG02" Color="#7FD8FF" />
          <SolidColorBrush x:Key="LegendG03" Color="#3B6BFF" />
          <SolidColorBrush x:Key="DiffChangedText" Color="#E0B040" />
          <SolidColorBrush x:Key="DiffRemovedText" Color="#E05555" />
          <SolidColorBrush x:Key="DiffAddedText" Color="#4CC070" />
          <SolidColorBrush x:Key="RibbonIcon" Color="#7FB8F0" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="RibbonBackground" Color="#EEF0F3" />
          <SolidColorBrush x:Key="PanelBackground" Color="#FAFAFB" />
          <SolidColorBrush x:Key="CardBackground" Color="#EEF0F3" />
          <SolidColorBrush x:Key="StatusBackground" Color="#E4E7EB" />
          <SolidColorBrush x:Key="SubtleBorder" Color="#C5CAD1" />
          <SolidColorBrush x:Key="TabHoverBackground" Color="#E4E7EB" />
          <SolidColorBrush x:Key="TabActiveBackground" Color="#CFDDF0" />
          <SolidColorBrush x:Key="HighlightText" Color="#9A7A00" />
          <SolidColorBrush x:Key="CuttingText" Color="#0071A8" />
          <SolidColorBrush x:Key="RapidText" Color="#A85F00" />
          <SolidColorBrush x:Key="LegendG00" Color="#D62828" />
          <SolidColorBrush x:Key="LegendG01" Color="#1F8A3A" />
          <SolidColorBrush x:Key="LegendG02" Color="#1E8FC8" />
          <SolidColorBrush x:Key="LegendG03" Color="#1D3FBF" />
          <SolidColorBrush x:Key="DiffChangedText" Color="#A87A00" />
          <SolidColorBrush x:Key="DiffRemovedText" Color="#C02020" />
          <SolidColorBrush x:Key="DiffAddedText" Color="#1F8A3A" />
          <SolidColorBrush x:Key="RibbonIcon" Color="#1F5FA8" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <!-- Estilos do editor de texto (AvaloniaEdit) -->
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

    <!-- Abas e botões mais compactos que o padrão do Fluent (que é pensado para toque) -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="12,4" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <!-- Botão da faixa de comandos: ícone em cima, texto embaixo (como no CIMCO) -->
    <Style Selector="Button.ribbon">
      <Setter Property="Padding" Value="8,4,8,3" />
      <Setter Property="MinWidth" Value="58" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.ribbon PathIcon">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource RibbonIcon}" />
    </Style>
    <Style Selector="Button.ribbon TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
    <Style Selector="RadioButton">
      <Setter Property="FontSize" Value="13" />
    </Style>
  </Application.Styles>
</Application>
