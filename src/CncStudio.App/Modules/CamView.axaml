<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:modules="using:CncStudio.App.Modules"
             x:Class="CncStudio.App.Modules.CamView">
  <DockPanel>
  <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,0,0,1" Padding="14,6">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="Máquina:" VerticalAlignment="Center" />
      <ToggleButton x:Name="LatheTab" Content="Torno" Padding="16,5" />
      <ToggleButton x:Name="MachineTab" Content="Perfil 4/5 eixos" Padding="16,5" />
      <ToggleButton x:Name="JobTab" Content="Trabalho fresa" Padding="16,5" IsChecked="True" />
      <ToggleButton x:Name="LatheJobTab" Content="Trabalho torno" Padding="16,5" />
      <ToggleButton x:Name="ModelTab" Content="Modelo 3D (STL/STEP)" Padding="16,5" />
    </StackPanel>
  </Border>
  <Grid>
  <modules:LatheCamView x:Name="LathePanel" IsVisible="False" />
  <modules:MachineProfileView x:Name="MachinePanel" IsVisible="False" />
  <modules:JobView x:Name="JobPanel" />
  <modules:LatheJobView x:Name="LatheJobPanel" IsVisible="False" />
  <modules:ModelView x:Name="ModelPanel" IsVisible="False" />
  </Grid>
  </DockPanel>
</UserControl>
