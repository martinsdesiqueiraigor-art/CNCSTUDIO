<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:modules="using:CncStudio.App.Modules"
             x:Class="CncStudio.App.Modules.CamView">
  <DockPanel>
  <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,0,0,1" Padding="14,6">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="Máquina:" VerticalAlignment="Center" />
      <ToggleButton x:Name="MillTab" Content="Fresa" Padding="16,5" IsChecked="True" />
      <ToggleButton x:Name="LatheTab" Content="Torno" Padding="16,5" />
      <ToggleButton x:Name="MachineTab" Content="Perfil 4/5 eixos" Padding="16,5" />
      <ToggleButton x:Name="JobTab" Content="Trabalho fresa" Padding="16,5" />
      <ToggleButton x:Name="LatheJobTab" Content="Trabalho torno" Padding="16,5" />
    </StackPanel>
  </Border>
  <Grid>
  <modules:LatheCamView x:Name="LathePanel" IsVisible="False" />
  <modules:MachineProfileView x:Name="MachinePanel" IsVisible="False" />
  <modules:JobView x:Name="JobPanel" IsVisible="False" />
  <modules:LatheJobView x:Name="LatheJobPanel" IsVisible="False" />
  <Grid x:Name="MillPanel" ColumnDefinitions="380,*">
    <Border Grid.Column="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,0,1,0">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,14" Spacing="8">
          <TextBlock Text="Casillas CAM" FontSize="20" FontWeight="Bold" />
          <TextBlock Text="Do desenho ao programa 2,5D (fresa). Fanuc e Siemens." Opacity="0.75" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="OpenDxfButton" Content="Abrir DXF…" Padding="14,7" FontWeight="SemiBold" />
            <TextBlock x:Name="FileName" VerticalAlignment="Center" Opacity="0.75" />
          </StackPanel>
          <Expander Header="Desenhar forma" IsExpanded="False">
            <StackPanel x:Name="ShapeFields" Spacing="4" Margin="0,4" />
          </Expander>
          <TextBlock Text="Contornos do desenho" FontWeight="Bold" Margin="0,6,0,0" />
          <ListBox x:Name="ContourList" MaxHeight="150" MinHeight="48" />
          <TextBlock Text="Ferramenta e alturas" FontWeight="Bold" Margin="0,6,0,0" />
          <ComboBox x:Name="BankCombo" HorizontalAlignment="Stretch" PlaceholderText="Ferramenta do banco…" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="SaveToolButton" Content="Salvar no banco" Padding="10,5" />
            <Button x:Name="DeleteToolButton" Content="Excluir do banco" Padding="10,5" />
          </StackPanel>
          <StackPanel x:Name="CommonFields" Spacing="4" />
          <TextBlock Text="Operação" FontWeight="Bold" Margin="0,6,0,0" />
          <ComboBox x:Name="OpCombo" HorizontalAlignment="Stretch" />
          <StackPanel x:Name="OpFields" Spacing="4" />
          <CheckBox x:Name="RotaryCheck" Content="Face girada no 4º eixo (perfil da máquina)" Margin="0,6,0,0" />
          <StackPanel x:Name="RotaryBox" Spacing="4" IsVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Eixo" Width="170" VerticalAlignment="Center" />
              <ComboBox x:Name="RotaryAxisCombo" SelectedIndex="0" Width="90"><ComboBoxItem Content="A" /><ComboBoxItem Content="B" /></ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Ângulo da face" Width="170" VerticalAlignment="Center" />
              <TextBox x:Name="RotaryAngleBox" Text="90" Width="90" MinHeight="26" />
              <TextBlock Text="°" VerticalAlignment="Center" Opacity="0.7" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Do centro do eixo até a face (virada para cima)" Width="170" TextWrapping="Wrap" VerticalAlignment="Center" />
              <TextBox x:Name="RotaryDistBox" Text="25" Width="90" MinHeight="26" />
              <TextBlock Text="mm" VerticalAlignment="Center" Opacity="0.7" />
            </StackPanel>
            <TextBlock Text="Desenhe a face de cima (Z 0 na face). O CAM leva o percurso para a face girada. Rode primeiro no ar e confira o sentido de A/B." TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
          </StackPanel>
          <Button x:Name="AddOpButton" Content="Adicionar operação" Padding="14,8" FontWeight="SemiBold" HorizontalAlignment="Stretch" />
          <TextBlock x:Name="Errors" TextWrapping="Wrap" Foreground="#FF9A83" />
        </StackPanel>
      </ScrollViewer>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="*,280">
      <Border Grid.Row="0" Margin="12" CornerRadius="8" ClipToBounds="True" Background="#0B1216" BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="1">
        <Grid>
          <modules:CamPreview x:Name="Preview" />
          <TextBlock x:Name="PreviewHint" Text="Abra um DXF ou desenhe uma forma para começar." HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" />
        </Grid>
      </Border>
      <Grid Grid.Row="1" ColumnDefinitions="300,*" Margin="12,0,12,12">
        <DockPanel Grid.Column="0" Margin="0,0,10,0">
          <TextBlock DockPanel.Dock="Top" Text="Operações do programa" FontWeight="Bold" Margin="0,0,0,4" />
          <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Comando:" VerticalAlignment="Center" />
              <ComboBox x:Name="DialectCombo" SelectedIndex="0" MinWidth="140">
                <ComboBoxItem Content="Fanuc" />
                <ComboBoxItem Content="Siemens" />
              </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="RemoveOpButton" Content="Remover" Padding="12,6" />
              <Button x:Name="GenerateButton" Content="Gerar programa" Padding="12,6" FontWeight="SemiBold" />
            </StackPanel>
          </StackPanel>
          <ListBox x:Name="OpList" />
        </DockPanel>
        <DockPanel Grid.Column="1">
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
            <Button x:Name="OpenButton" Content="Abrir no editor (simular no Code)" Padding="12,6" IsEnabled="False" />
            <Button x:Name="CopyButton" Content="Copiar" Padding="12,6" IsEnabled="False" />
            <TextBlock Text="Simule antes de rodar na máquina." VerticalAlignment="Center" Opacity="0.6" FontSize="12" />
          </StackPanel>
          <TextBlock x:Name="Warnings" DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#F2C45A" FontSize="12" />
          <TextBox x:Name="Output" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                   FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="12" />
        </DockPanel>
      </Grid>
    </Grid>
  </Grid>
  </Grid>
  </DockPanel>
</UserControl>
