<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CncStudio.App.Modules.HomeView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,16,32,28" Spacing="10" MaxWidth="1000" HorizontalAlignment="Center">
      <Image x:Name="Logo" Width="190" Height="190" HorizontalAlignment="Center" Margin="0,0,0,-14" />
      <TextBlock Text="Plataforma Casillas" FontSize="26" FontWeight="Bold" Foreground="#F3D9A4" HorizontalAlignment="Center" />
      <TextBlock Text="Editar, simular e programar usinagem CNC em português" Opacity="0.7" HorizontalAlignment="Center" Margin="0,0,0,8" />
      <TextBlock Text="No desktop" FontSize="14" FontWeight="SemiBold" Opacity="0.8" HorizontalAlignment="Center" />
      <ItemsControl x:Name="Cards">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel HorizontalAlignment="Center" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
      <TextBlock Text="Na versão web (abre no navegador, precisa de internet)" FontSize="14" FontWeight="SemiBold" Opacity="0.8" HorizontalAlignment="Center" Margin="0,10,0,0" />
      <ItemsControl x:Name="WebCards">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel HorizontalAlignment="Center" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
      <TextBlock Text="Formação profissional • Gestão de usinagem • Análise e otimização • Editores avançados"
                 FontSize="12" Foreground="#C9A96A" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
