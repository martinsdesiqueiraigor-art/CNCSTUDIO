<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CncStudio.App.Modules.StoreView">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource CardBackground}" Padding="14,10"
            BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,1,0,0">
      <Button x:Name="OrderButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="16,10"
              FontWeight="SemiBold" IsEnabled="False" Content="Pedir pelo WhatsApp (0)" />
    </Border>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="28,20" Spacing="12" MaxWidth="820" HorizontalAlignment="Stretch">
        <TextBlock Text="Casillas Loja" FontSize="24" FontWeight="Bold" />
        <Border Background="#3B2F12" BorderBrush="#7A6122" BorderThickness="1" CornerRadius="8" Padding="10">
          <TextBlock x:Name="Notice" TextWrapping="Wrap" FontSize="13" Foreground="#F3C969" />
        </Border>
        <StackPanel x:Name="Items" Spacing="12" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
