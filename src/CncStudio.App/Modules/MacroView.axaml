<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CncStudio.App.Modules.MacroView">
  <Grid ColumnDefinitions="250,*" Margin="0">
    <Border Grid.Column="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,0,1,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Geradores" FontSize="18" FontWeight="Bold" Margin="14,14,14,8" />
        <ListBox x:Name="GeneratorList" Background="Transparent" Margin="6,0" />
      </DockPanel>
    </Border>
    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,18" Spacing="10" MaxWidth="820" HorizontalAlignment="Stretch">
        <TextBlock x:Name="Title" FontSize="22" FontWeight="Bold" />
        <TextBlock x:Name="Description" TextWrapping="Wrap" Opacity="0.8" />
        <StackPanel x:Name="Fields" Spacing="6" />
        <StackPanel x:Name="ModePanel" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
          <TextBlock Text="Saída:" VerticalAlignment="Center" />
          <ComboBox x:Name="ModeCombo" SelectedIndex="0" MinWidth="260">
            <ComboBoxItem Content="Programa pronto" />
            <ComboBoxItem Content="Chamada G65 + macro" />
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="GenerateButton" Content="Gerar programa" Padding="16,8" FontWeight="SemiBold" />
          <Button x:Name="OpenButton" Content="Abrir no editor (simular no Code)" Padding="16,8" IsEnabled="False" />
          <Button x:Name="CopyButton" Content="Copiar" Padding="16,8" IsEnabled="False" />
        </StackPanel>
        <TextBlock x:Name="Errors" TextWrapping="Wrap" Foreground="#FF9A83" />
        <TextBox x:Name="Output" IsReadOnly="True" AcceptsReturn="True" MinHeight="220" TextWrapping="NoWrap"
                 FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="13" />
        <TextBlock Text="Simule antes de rodar na máquina." FontSize="12" Opacity="0.6" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
