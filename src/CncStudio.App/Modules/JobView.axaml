<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:modules="using:CncStudio.App.Modules"
             x:Class="CncStudio.App.Modules.JobView">
  <!-- Casca nova do Trabalho fresa (UX-04c): paleta azul-grafite; laranja só em ação e seleção. Sempre escuro, como os mockups F2/G. -->
  <UserControl.Resources>
    <SolidColorBrush x:Key="CardBackground" Color="{x:Static modules:CamColors.PanelColor}" />
    <SolidColorBrush x:Key="PanelBackground" Color="{x:Static modules:CamColors.BgColor}" />
    <SolidColorBrush x:Key="SubtleBorder" Color="{x:Static modules:CamColors.BorderColor}" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="{x:Static modules:CamColors.SelectBgColor}" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="{x:Static modules:CamColors.SelectHoverColor}" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPressed" Color="{x:Static modules:CamColors.SelectHoverColor}" />
    <SolidColorBrush x:Key="TreeViewItemForegroundSelected" Color="White" />
    <SolidColorBrush x:Key="TreeViewItemForegroundSelectedPointerOver" Color="White" />
    <SolidColorBrush x:Key="TreeViewItemBorderBrushSelected" Color="{x:Static modules:CamColors.SelectColor}" />
    <SolidColorBrush x:Key="TreeViewItemBorderBrushSelectedPointerOver" Color="{x:Static modules:CamColors.SelectColor}" />
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Border.camcard">
      <Setter Property="Background" Value="{x:Static modules:CamColors.PanelBrush}" />
      <Setter Property="BorderBrush" Value="{x:Static modules:CamColors.BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
  </UserControl.Styles>
  <ThemeVariantScope RequestedThemeVariant="Dark">
  <Grid RowDefinitions="Auto,*,Auto,Auto" Background="{x:Static modules:CamColors.BgBrush}">
  <!-- Faixa de ícones agrupada (CamPalette, Core): só na aba Operações -->
  <Border x:Name="PaletteBar" Grid.Row="0" Background="{x:Static modules:CamColors.BandBrush}" BorderBrush="{x:Static modules:CamColors.BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
    <!-- banco ativo (UX-04h B2) fixo à direita, fora da rolagem: sempre à vista em 1280×720 -->
    <DockPanel>
      <Border x:Name="BankSlot" DockPanel.Dock="Right" BorderBrush="{x:Static modules:CamColors.BorderBrush}" BorderThickness="1,0,0,0" Padding="8,0,0,0" Margin="6,0,0,0" />
      <!-- CAM-STOCK-02: bruto depois de cada operação (preferência do app, nunca no trabalho) -->
      <ToggleButton x:Name="StockStepsToggle" DockPanel.Dock="Right" IsChecked="True" Content="Bruto por operação: Ligado" Padding="10,3" MinHeight="26" FontSize="12" CornerRadius="13" VerticalAlignment="Center" Margin="6,0,0,0" />
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Palette" Orientation="Horizontal" Spacing="0" />
      </ScrollViewer>
    </DockPanel>
  </Border>
  <!-- Árvore | divisória | centro | divisória | painel. Divisórias arrastáveis (duplo clique volta ao padrão 240 e 290);
       as larguras ficam nas preferências do app, nunca no .casillas-job -->
  <Grid x:Name="Panes" Grid.Row="1">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240" MinWidth="200" MaxWidth="420" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="*" MinWidth="480" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="290" MinWidth="260" MaxWidth="520" />
    </Grid.ColumnDefinitions>
    <!-- Árvore: Máquina, Material, Peça, Bruto, Ferramentas e Fixação 1 com o zero e as operações -->
    <Border Grid.Column="0" Background="{x:Static modules:CamColors.PanelBrush}">
      <DockPanel Margin="8,8">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" ColumnSpacing="6">
          <TextBlock Text="Trabalho:" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" x:Name="NameBox" MinHeight="26" FontSize="12" ToolTip.Tip="Nome do trabalho" />
        </Grid>
        <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,6,0,0">
          <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="4" RowSpacing="4">
            <Button x:Name="UpButton" Content="Subir" Padding="2,4" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button Grid.Column="1" x:Name="DownButton" Content="Descer" Padding="2,4" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button Grid.Column="2" x:Name="DuplicateButton" Content="Duplicar" Padding="2,4" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button Grid.Row="1" x:Name="RemoveButton" Content="Remover" Padding="2,4" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button Grid.Row="1" Grid.Column="1" x:Name="UndoButton" Content="Desfazer" Padding="2,4" FontSize="12" IsEnabled="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          </Grid>
        </StackPanel>
        <TreeView x:Name="Tree" Margin="0,6,0,0" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
      </DockPanel>
    </Border>
    <GridSplitter x:Name="TreeSplitter" Grid.Column="1" ResizeDirection="Columns" Background="{x:Static modules:CamColors.BorderBrush}" ToolTip.Tip="Arraste para mudar a largura da árvore. Duplo clique volta ao padrão." />
    <DockPanel Grid.Column="2">
      <modules:AvisosConsole x:Name="AvisosBox" DockPanel.Dock="Bottom" Margin="10,0,10,4" />
      <!-- UI-05: linha do tempo das operações (só na aba Operações) -->
      <modules:CamTimeline x:Name="Timeline" DockPanel.Dock="Bottom" Margin="10,0,10,4" IsVisible="False" />
      <Grid>
        <!-- Aba Operações: vista 2D/3D (a mesma de antes) -->
        <Border x:Name="OpsCenter" Margin="10,10,10,6" CornerRadius="8" ClipToBounds="True" Background="{x:Static modules:CamColors.ViewportBrush}" BorderBrush="{x:Static modules:CamColors.BorderBrush}" BorderThickness="1">
          <Grid ColumnDefinitions="*,Auto">
          <Grid>
            <modules:CamPreview x:Name="Preview" />
            <modules:MillJobSceneView x:Name="Scene3D" IsVisible="False" />
            <ToggleButton x:Name="View3DButton" Content="3D" Padding="12,4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" />
            <modules:ViewCube x:Name="Cube" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,48,8,0" IsVisible="False" />
            <TextBlock x:Name="PreviewHint" Text="Comece com Novo, abra um DXF (faixa Arquivo) ou um trabalho salvo, escolha o STEP da peça (Preparação) ou desenhe uma forma (item Peça)." HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" />
          </Grid>
          <modules:ToolLibrary x:Name="Library" Grid.Column="1" />
          </Grid>
        </Border>
        <!-- Aba Preparação (UX-04f): 3 colunas para caber em 1280×720 sem rolar. Máquina (leitura), Peça pronta, Banco e Material
             (em breve) | Bruto | Zero (leitura) e Fixação (a mesma de antes) -->
        <ScrollViewer x:Name="PrepCenter" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="8">
            <StackPanel Grid.Column="0">
              <Border Classes="camcard"><StackPanel x:Name="PrepMachine" Spacing="4" /></Border>
              <Border Classes="camcard"><StackPanel x:Name="PrepPart" Spacing="4" /></Border>
              <Border Classes="camcard" Opacity="0.6" ToolTip.Tip="Em breve. Hoje a ferramenta vem da tabela do Code, nas propriedades de cada operação.">
                <TextBlock Text="Banco de ferramentas · em breve" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
              </Border>
              <Border Classes="camcard" Opacity="0.6" ToolTip.Tip="Em breve: ainda não existe no Casillas CAM.">
                <TextBlock Text="Material: não definido · em breve" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
            <Border Grid.Column="1" Classes="camcard" VerticalAlignment="Top"><StackPanel x:Name="PrepStock" Spacing="4" /></Border>
            <StackPanel Grid.Column="2">
              <Border Classes="camcard"><StackPanel x:Name="PrepOrigin" Spacing="6" /></Border>
              <Border Classes="camcard"><StackPanel x:Name="PrepFixture" Spacing="6" /></Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>
        <!-- Aba Código NC: o mesmo campo de antes -->
        <Border x:Name="CodeCenter" IsVisible="False" Margin="10,10,10,6" CornerRadius="8" Padding="10,6" Background="{x:Static modules:CamColors.PanelBrush}" BorderBrush="{x:Static modules:CamColors.BorderBrush}" BorderThickness="1">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
              <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="Copiar" Padding="10,3" IsEnabled="False" />
              <TextBlock x:Name="CodeTitle" Text="Código CNC" FontSize="12" Opacity="0.85" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
            <TextBox x:Name="Output" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="12" />
          </DockPanel>
        </Border>
      </Grid>
    </DockPanel>
    <!-- Painel direito (290 px): parâmetros da operação ou do item escolhido na árvore; só na aba Operações -->
    <GridSplitter x:Name="PropsSplitter" Grid.Column="3" ResizeDirection="Columns" Background="{x:Static modules:CamColors.BorderBrush}" ToolTip.Tip="Arraste para mudar a largura do painel. Duplo clique volta ao padrão." />
    <Border x:Name="RightColumn" Grid.Column="4" Background="{x:Static modules:CamColors.PanelBrush}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="OpPanel" Margin="12,10" Spacing="6" />
      </ScrollViewer>
    </Border>
  </Grid>
  <!-- Barra por último no XAML: no Tab ela vem depois da coluna da esquerda e da árvore -->
  <modules:JobBar x:Name="Bar" Grid.Row="2" Compact="True" />
  <!-- Linha de status: incompletas, fixação atual, número do programa (o valor que está no trabalho) e controle -->
  <Border Grid.Row="3" Background="{x:Static modules:CamColors.ChromeBrush}" BorderBrush="{x:Static modules:CamColors.BorderBrush}" BorderThickness="0,1,0,0" Padding="12,2">
    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="16">
      <TextBlock x:Name="StatusIncomplete" VerticalAlignment="Center" FontSize="12" />
      <TextBlock Grid.Column="1" Text="Fixação 1 de 1" VerticalAlignment="Center" FontSize="12" Foreground="{x:Static modules:CamColors.MutedBrush}" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16">
        <TextBlock x:Name="StatusProgram" VerticalAlignment="Center" FontSize="12" Foreground="{x:Static modules:CamColors.MutedBrush}" />
        <TextBlock x:Name="StatusStock" VerticalAlignment="Center" FontSize="12" Foreground="{x:Static modules:CamColors.MutedBrush}" />
      </StackPanel>
      <TextBlock Grid.Column="3" x:Name="StatusMachine" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="4" Text="Controle:" VerticalAlignment="Center" FontSize="12" Foreground="{x:Static modules:CamColors.MutedBrush}" />
      <ComboBox Grid.Column="5" x:Name="DialectCombo" SelectedIndex="0" MinWidth="96" FontSize="12" MinHeight="24" Padding="8,1" ToolTip.Tip="Comando (dialeto do programa)">
        <ComboBoxItem Content="Fanuc" />
        <ComboBoxItem Content="Siemens" />
      </ComboBox>
    </Grid>
  </Border>
  </Grid>
  </ThemeVariantScope>
</UserControl>
