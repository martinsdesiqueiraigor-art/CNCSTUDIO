<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:modules="using:CncStudio.App.Modules"
             x:Class="CncStudio.App.Modules.JobView">
  <Grid RowDefinitions="*,Auto">
  <Grid ColumnDefinitions="330,*,330">
    <!-- Coluna compacta (UX-01, mínimo 1280×720): botões em uma linha cada, para a árvore ter ~8 linhas -->
    <Border Grid.Column="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,0,1,0">
      <DockPanel Margin="10,10">
        <StackPanel DockPanel.Dock="Top" Spacing="6">
          <TextBlock Text="Trabalho (fresa)" FontSize="18" FontWeight="Bold"
                     ToolTip.Tip="Peça, operações e programa num lugar só. Mude a ordem, desligue ou duplique operações." />
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button x:Name="OpenDxfButton" Content="Abrir DXF…" Padding="6,4" FontSize="12" />
            <Button x:Name="OpenJobButton" Content="Abrir trabalho…" Padding="6,4" FontSize="12" />
            <Button x:Name="SaveJobButton" Content="Salvar trabalho…" Padding="6,4" FontSize="12" />
          </StackPanel>
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
            <TextBlock Text="Nome" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" x:Name="NameBox" MinHeight="26" />
            <ComboBox Grid.Column="2" x:Name="DialectCombo" SelectedIndex="0" MinWidth="96" ToolTip.Tip="Comando (dialeto do programa)">
              <ComboBoxItem Content="Fanuc" />
              <ComboBoxItem Content="Siemens" />
            </ComboBox>
          </Grid>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <ComboBox x:Name="KindCombo" HorizontalAlignment="Stretch" />
            <Button Grid.Column="1" x:Name="AddButton" Content="Adicionar" Padding="10,5" FontWeight="SemiBold" ToolTip.Tip="Adicionar operação" />
          </Grid>
          <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="4">
            <Button x:Name="UpButton" Content="Subir" Padding="2,4" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button Grid.Column="1" x:Name="DownButton" Content="Descer" Padding="2,4" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button Grid.Column="2" x:Name="DuplicateButton" Content="Duplicar" Padding="2,4" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button Grid.Column="3" x:Name="RemoveButton" Content="Remover" Padding="2,4" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button Grid.Column="4" x:Name="UndoButton" Content="Desfazer" Padding="2,4" FontSize="12" IsEnabled="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          </Grid>
          <ScrollViewer MaxHeight="40" HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="Errors" TextWrapping="Wrap" Foreground="#FF9A83" FontSize="12" />
          </ScrollViewer>
        </StackPanel>
        <TreeView x:Name="Tree" Margin="0,8,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="*,190">
      <!-- Código CNC embaixo da vista (UX-01): o mesmo campo de antes, que ficava na aba Código -->
      <Border Grid.Row="1" Margin="12,0,12,10" CornerRadius="8" Padding="10,6" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="1">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="Copiar" Padding="10,3" IsEnabled="False" />
            <TextBlock x:Name="CodeTitle" Text="Código CNC" FontSize="12" Opacity="0.8" VerticalAlignment="Center" />
          </DockPanel>
          <ScrollViewer DockPanel.Dock="Top" MaxHeight="48" HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="Warnings" TextWrapping="Wrap" Foreground="#F2C45A" FontSize="12" />
          </ScrollViewer>
          <TextBox x:Name="Output" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                   FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="12" />
        </DockPanel>
      </Border>
      <Border Margin="12,12,12,8" CornerRadius="8" ClipToBounds="True" Background="#0B1216" BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="1">
        <Grid>
          <modules:CamPreview x:Name="Preview" />
          <modules:JobSceneView x:Name="Scene3D" IsVisible="False" />
          <ToggleButton x:Name="View3DButton" Content="3D" Padding="12,4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" />
          <TextBlock x:Name="PreviewHint" Text="Abra um DXF, um trabalho salvo ou desenhe uma forma (item Peça) para começar." HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" />
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Column="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="1,0,0,0">
      <TabControl x:Name="RightTabs" Margin="0,4,0,0">
        <TabItem Header="Propriedades">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PropsPanel" Margin="14,12" Spacing="6" />
      </ScrollViewer>
        </TabItem>
      </TabControl>
    </Border>
  </Grid>
  <!-- Barra por último no XAML: no Tab ela vem depois da coluna da esquerda e da árvore -->
  <modules:JobBar x:Name="Bar" Grid.Row="1" />
  </Grid>
</UserControl>
