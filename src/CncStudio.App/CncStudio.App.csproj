<Project Sdk="Microsoft.NET.Sdk">

  <!-- Interface desktop do Casillas Code (Avalonia; nome interno do código: CncStudio). Toda a lógica de G-code fica no Core. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>CncStudio.App</RootNamespace>
    <AssemblyName>CasillasCode</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Cópia direta de pixels para o WriteableBitmap da simulação -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\casillas-code.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Casillas Code</Product>
    <AssemblyTitle>Casillas Code</AssemblyTitle>
    <Company>Casillas</Company>
    <Description>Editor e simulador de programas CNC (Fanuc e Siemens)</Description>

    <!-- Executável menor: arquivo único compactado e só os idiomas usados.
         (Trimming fica desligado: o Avalonia usa reflexão e não dá para testar aqui sem Windows.) -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en;pt-BR</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Versões fixas: a build de hoje e a de daqui a um ano usam exatamente os mesmos pacotes -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.3.0" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- Ilustrações da plataforma: as mesmas da versão web (uma fonte só) -->
    <AvaloniaResource Include="..\CncStudio.Web\wwwroot\img\plataforma\*.webp" Link="Assets\plataforma\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CncStudio.Core\CncStudio.Core.csproj" />
    <!-- Leitura de STEP (OpenCASCADE): só no desktop -->
    <ProjectReference Include="..\CncStudio.Step\CncStudio.Step.csproj" />
  </ItemGroup>

  <!--
    LIC-01: o pacote OcctNet.Wrapper (via CncStudio.Step) traz 69 DLLs nativas, mas a leitura de STEP
    só carrega 36. As 33 abaixo (FFmpeg, FreeImage, OpenVR, TBB, jemalloc, vcomp140, brotlienc e
    módulos do OpenCASCADE de outros formatos, OpenGL e persistência) ficam fora da publicação:
    executável menor e menos licenças a declarar. Só afeta o publish; build e testes seguem iguais.
    Lista conferida em inventario/dlls_nativas.csv (coluna Candidata_remocao).
  -->
  <ItemGroup>
    <NativeOcctNaoUsada Include="avcodec-57.dll;avformat-57.dll;avutil-55.dll;swscale-4.dll" />
    <NativeOcctNaoUsada Include="FreeImage.dll;openvr_api.dll;tbb12.dll;jemalloc.dll;vcomp140.dll;brotlienc.dll" />
    <NativeOcctNaoUsada Include="TKBin.dll;TKBinL.dll;TKBinTObj.dll;TKBinXCAF.dll;TKDECascade.dll;TKDEGLTF.dll" />
    <NativeOcctNaoUsada Include="TKDEOBJ.dll;TKDEPLY.dll;TKDEVRML.dll;TKFeat.dll;TKFillet.dll;TKMeshVS.dll" />
    <NativeOcctNaoUsada Include="TKOffset.dll;TKOpenGl.dll;TKRWMesh.dll;TKStd.dll;TKStdL.dll;TKTObj.dll" />
    <NativeOcctNaoUsada Include="TKXMesh.dll;TKXml.dll;TKXmlL.dll;TKXmlTObj.dll;TKXmlXCAF.dll" />
  </ItemGroup>
  <Target Name="TirarNativasOcctNaoUsadas" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_NativaFora Include="@(NativeOcctNaoUsada)" RelativePath="%(Identity)" />
      <ResolvedFileToPublish Remove="@(_NativaFora)" MatchOnMetadata="RelativePath" MatchOnMetadataOptions="CaseInsensitive" />
    </ItemGroup>
  </Target>

  <!-- Exemplos acessíveis pelos botões "Exemplo Fanuc" / "Exemplo Siemens" -->
  <ItemGroup>
    <None Include="..\..\samples\**\*.*" LinkBase="samples" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
