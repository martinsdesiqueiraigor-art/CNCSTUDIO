<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:web="using:CncStudio.Web"
             x:Class="CncStudio.Web.MainView"
             Background="{DynamicResource AppBackground}">

  <UserControl.Styles>
    <!-- Botões da barra: grandes o bastante para o dedo -->
    <Style Selector="Button.bar">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.sim">
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Margin" Value="2,3" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.sim PathIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="Button.play">
      <Setter Property="Background" Value="{DynamicResource BrandOrange}" />
      <Setter Property="Foreground" Value="#0D1117" />
      <Setter Property="MinWidth" Value="56" />
    </Style>
    <Style Selector="Button.problems">
      <Setter Property="Foreground" Value="#FF7B72" />
      <Setter Property="BorderBrush" Value="#F85149" />
    </Style>
    <Style Selector="Button.problems.warnings">
      <Setter Property="Foreground" Value="#E3B341" />
      <Setter Property="BorderBrush" Value="#E3B341" />
    </Style>
    <Style Selector="ToggleButton.view">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="12,4" />
    </Style>
    <Style Selector="ToggleButton.page">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="18,6" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- Barra superior: marca + ações -->
    <Border Grid.Row="0" Background="{DynamicResource BarBackground}" BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,0,0,1">
      <DockPanel Margin="10,6" LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Image Source="/Assets/simbolo.png" Height="24" />
          <TextBlock x:Name="BrandText" VerticalAlignment="Center" FontSize="16" FontWeight="Bold">
            <Run Text="Casillas" /><Run Text=" Code" Foreground="{DynamicResource BrandBlue}" />
          </TextBlock>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <!-- Celular deitado: alternar Código/Gráfico aqui em cima, para sobrar altura -->
          <StackPanel x:Name="HeaderPages" Orientation="Horizontal" IsVisible="False" Margin="0,0,6,0">
            <ToggleButton x:Name="HeaderCodeButton" Classes="page" Content="Código" IsChecked="True" CornerRadius="6,0,0,6" />
            <ToggleButton x:Name="HeaderGraphButton" Classes="page" Content="Gráfico" CornerRadius="0,6,6,0" />
          </StackPanel>
          <Button x:Name="OpenButton" Classes="bar" Content="Abrir" ToolTip.Tip="Abrir um programa do aparelho" />
          <Button x:Name="ExamplesButton" Classes="bar" Content="Exemplos" />
          <ComboBox x:Name="DialectCombo" MinHeight="36" SelectedIndex="0" ToolTip.Tip="Dialeto do comando">
            <ComboBoxItem Content="Fanuc" />
            <ComboBoxItem Content="Siemens" />
          </ComboBox>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Celular: alterna entre código e gráfico (no PC os dois ficam lado a lado) -->
    <Grid x:Name="PageSwitch" Grid.Row="1" ColumnDefinitions="*,*" Margin="8,6,8,0" IsVisible="False">
      <ToggleButton x:Name="CodePageButton" Grid.Column="0" Classes="page" Content="Código" IsChecked="True" HorizontalAlignment="Stretch" CornerRadius="6,0,0,6" />
      <ToggleButton x:Name="GraphPageButton" Grid.Column="1" Classes="page" Content="Gráfico" HorizontalAlignment="Stretch" CornerRadius="0,6,6,0" />
    </Grid>

    <!-- Área principal: editor e backplot -->
    <Grid x:Name="Workspace" Grid.Row="2" ColumnDefinitions="*,6,*" Margin="0,6,0,0">
      <Border x:Name="EditorHost" Grid.Column="0" BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,1,1,1">
        <Grid RowDefinitions="Auto,*">
          <DockPanel Grid.Row="0" Margin="10,4,6,4">
            <!-- Celular: edição no editor nativo do aparelho (o teclado virtual funciona direito lá) -->
            <Button x:Name="EditButton" DockPanel.Dock="Right" Classes="bar" Content="Editar" IsVisible="False"
                    ToolTip.Tip="Editar o programa com o teclado do aparelho" />
            <Button x:Name="ProblemsButton" DockPanel.Dock="Right" Classes="bar problems" IsVisible="False" Margin="0,0,6,0"
                    ToolTip.Tip="Ir para o próximo erro ou aviso" />
            <TextBlock x:Name="FileNameText" VerticalAlignment="Center" FontWeight="SemiBold" Opacity="0.85" Text="sem título"
                       TextTrimming="CharacterEllipsis" />
          </DockPanel>
          <ae:TextEditor x:Name="Editor" Grid.Row="1"
                         FontFamily="{StaticResource CodeFont}" FontSize="14"
                         ShowLineNumbers="True" WordWrap="False"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource AppBackground}" Foreground="#D4D4D4" />
        </Grid>
      </Border>
      <GridSplitter x:Name="Splitter" Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource SubtleBorder}" />
      <Grid x:Name="GraphHost" Grid.Column="2" RowDefinitions="Auto,*,Auto">
        <!-- Cabeçalho do gráfico: vista (fresa) ou plano do torno -->
        <DockPanel x:Name="GraphHeader" Grid.Row="0" Margin="8,4" LastChildFill="False">
          <TextBlock x:Name="LatheLabel" DockPanel.Dock="Left" VerticalAlignment="Center" Text="Torno · plano ZX" Opacity="0.7" />
          <StackPanel x:Name="MillViews" DockPanel.Dock="Left" Orientation="Horizontal" Spacing="4">
            <ToggleButton x:Name="IsoViewButton" Classes="view" Content="2,5D" IsChecked="True" ToolTip.Tip="Isométrica: mostra as profundidades" />
            <ToggleButton x:Name="TopViewButton" Classes="view" Content="Topo" ToolTip.Tip="Vista de cima (XY)" />
            <ToggleButton x:Name="FrontViewButton" Classes="view" Content="Frente" ToolTip.Tip="Vista de frente (XZ)" />
          </StackPanel>
          <Button x:Name="FitButton" DockPanel.Dock="Right" Classes="bar" Content="Ajustar" ToolTip.Tip="Mostrar a peça inteira (ou duplo toque no gráfico)" />
        </DockPanel>

        <web:BackplotView x:Name="Backplot" Grid.Row="1" />

        <!-- Simulação: linha a linha do programa, com pausa -->
        <Border Grid.Row="2" Background="{DynamicResource BarBackground}" BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,1,0,0">
          <StackPanel Margin="8,6" Spacing="6">
            <WrapPanel HorizontalAlignment="Center">
              <Button x:Name="SimStartButton" Classes="sim" ToolTip.Tip="Voltar ao início">
                <PathIcon Data="M0,0 H2.5 V12 H0 Z M12,0 L3.5,6 L12,12 Z" />
              </Button>
              <Button x:Name="SimBackButton" Classes="sim" ToolTip.Tip="Linha anterior">
                <PathIcon Data="M0,0 H2.5 V12 H0 Z M11,0 L3.5,6 L11,12 Z" />
              </Button>
              <Button x:Name="SimPlayButton" Classes="sim play" ToolTip.Tip="Executar / pausar">
                <PathIcon x:Name="SimPlayIcon" Data="M0,0 L11,6 L0,12 Z" />
              </Button>
              <Button x:Name="SimStepButton" Classes="sim" ToolTip.Tip="Próxima linha">
                <PathIcon Data="M0,0 L7.5,6 L0,12 Z M8.5,0 H11 V12 H8.5 Z" />
              </Button>
              <Button x:Name="SimEndButton" Classes="sim" ToolTip.Tip="Ir ao fim (trajetória completa)">
                <PathIcon Data="M0,0 L8.5,6 L0,12 Z M9.5,0 H12 V12 H9.5 Z" />
              </Button>
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0,0,0">
                <Slider x:Name="SpeedSlider" Width="110" Minimum="1" Maximum="50" Value="5" VerticalAlignment="Center" />
                <TextBlock x:Name="SpeedText" VerticalAlignment="Center" FontSize="12" Width="70" Text="5 linhas/s" />
              </StackPanel>
            </WrapPanel>
            <WrapPanel x:Name="SimInfoRow">
              <TextBlock x:Name="SimPositionText" FontSize="12" Opacity="0.85" VerticalAlignment="Center" Margin="0,0,16,2" />
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="- - G00" Foreground="#FF4D4D" FontSize="12" />
                <TextBlock Text="— G01" Foreground="#3DDC6A" FontSize="12" />
                <TextBlock Text="— G02" Foreground="#7FD8FF" FontSize="12" />
                <TextBlock Text="— G03" Foreground="#3D6BFF" FontSize="12" />
              </StackPanel>
            </WrapPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- Rodapé: resumo da análise -->
    <Border Grid.Row="3" Background="{DynamicResource BarBackground}" BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,1,0,0">
      <TextBlock x:Name="StatusText" Margin="10,5" FontSize="12" TextTrimming="CharacterEllipsis" Opacity="0.85" />
    </Border>
  </Grid>
</UserControl>
