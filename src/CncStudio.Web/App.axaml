<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CncStudio.Web.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <!-- Cores da marca Casillas -->
    <SolidColorBrush x:Key="AppBackground" Color="#0D1117" />
    <SolidColorBrush x:Key="BarBackground" Color="#161B22" />
    <SolidColorBrush x:Key="SubtleBorder" Color="#30363D" />
    <SolidColorBrush x:Key="BrandOrange" Color="#F0883E" />
    <SolidColorBrush x:Key="BrandBlue" Color="#58A6FF" />
    <FontFamily x:Key="CodeFont">avares://CncStudio.Web/Assets/Fonts#DejaVu Sans Mono</FontFamily>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
  </Application.Styles>
</Application>
