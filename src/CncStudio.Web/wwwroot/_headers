# Cabeçalhos do Cloudflare Pages
# Arquivos do .NET têm o "hash" no nome: podem ficar guardados para sempre no navegador
/_framework/*
  Cache-Control: public, max-age=31536000, immutable
# A página e o service worker precisam ser conferidos a cada visita (para chegar a versão nova)
/index.html
  Cache-Control: no-cache
/service-worker.js
  Cache-Control: no-cache
