# Cabeçalhos do Cloudflare Pages
# Os .wasm do .NET têm o "hash" no nome: podem ficar guardados para sempre no navegador
# (dotnet.js e avalonia.js não têm hash e seguem o cache padrão, com revalidação)
/_framework/*.wasm
  Cache-Control: public, max-age=31536000, immutable
# A página e o service worker precisam ser conferidos a cada visita (para chegar a versão nova)
/index.html
  Cache-Control: no-cache
/service-worker.js
  Cache-Control: no-cache
